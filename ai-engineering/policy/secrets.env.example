# Playwright MCP --secrets file, dotenv format.
#
# This mechanism replaces matching values with placeholders in tool responses so
# they do not enter the model context. Upstream calls it "a convenience and not a
# security feature". It is literal string substitution: it fails as soon as the
# value is encoded, truncated, split across nodes, or derived.
#
# Treat it as the THIRD barrier of ADR-0002, never as the only one. The first,
# "the secret does not exist", is the only one that cannot be worked around.
#
# Copy to `secrets.env` (git-ignored). Never commit the real file.

# Synthetic SUT credentials. Worthless outside the local container: they are here
# to exercise the mechanism, not to protect anything.
SUT_USER_EMAIL=alice.durand@qa-ai-optional.test
SUT_USER_PASSWORD=Seed!Alice2026
